# 依赖
node_modules/

# 构建输出
dist/
out/
release/

# 宠物渲染器构建产物（由 `npm run build:pet` 自动生成）
src/renderer/pet/pet-bundle.js
src/renderer/pet/live2dcubismcore.js

# 动作预览工具的构建产物（由 `preview.bat` 自动生成）
tools/preview-bundle.js

# 本地配置 / 日志
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.codex/

# 环境变量（项目本身不用，防止误提交本地密钥）
.env
.env.*

# 本地运行数据（正常位于 %APPDATA%；此处为防误提交）
config.json
totals.json
life-tags.json

# 运行时生成
*.local
